# PostgreSQL connection URL used by SQLAlchemy
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/developer_productivity_dashboard

# JWT Secret & Expiration
JWT_SECRET_KEY=change_this_to_a_secure_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI API configuration (OpenRouter / OpenAI)
AI_API_KEY=your_ai_api_key_here
AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=meta-llama/llama-3.1-8b-instruct

# SMTP / Gmail Mail Configuration (FastAPI-Mail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=Dev Productivity
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
MAIL_USE_CREDENTIALS=True
MAIL_VALIDATE_CERTS=True
